<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="12dp"
  app:cardBackgroundColor="@color/navy_800"
  app:cardCornerRadius="16dp"
  app:cardElevation="0dp"
  app:strokeColor="@color/navy_700"
  app:strokeWidth="1dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
      android:id="@+id/name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="@color/cream"
      android:textSize="16sp"
      android:textStyle="bold"
      tools:text="Adetunji Bakinson"/>

    <TextView
      android:id="@+id/meta"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="@color/gold"
      android:textSize="13sp"
      tools:text="Roster 1 May · sheet 1 May · same day"/>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_pair"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:backgroundTint="@color/gold"
      android:text="@string/alumni_pair_this"
      android:textColor="@color/navy_950"/>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
