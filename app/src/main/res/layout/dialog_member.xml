<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:padding="8dp">

  <com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/member_name">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/input_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textPersonName|textCapWords"
      android:textColor="@color/cream"/>
  </com.google.android.material.textfield.TextInputLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/month"
    android:textColor="@color/text_muted"/>

  <Spinner
    android:id="@+id/spinner_month"
    android:layout_width="match_parent"
    android:layout_height="48dp"/>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/day"
    android:textColor="@color/text_muted"/>

  <Spinner
    android:id="@+id/spinner_day"
    android:layout_width="match_parent"
    android:layout_height="48dp"/>

  <TextView
    android:id="@+id/label_gender"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/alumni_gender"
    android:textColor="@color/text_muted"/>

  <Spinner
    android:id="@+id/spinner_gender"
    android:layout_width="match_parent"
    android:layout_height="48dp"/>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/layout_honorific"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:hint="@string/alumni_honorific">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/input_honorific"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textPersonName|textCapWords"
      android:textColor="@color/cream"/>
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/layout_phone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:hint="@string/alumni_phone">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/input_phone"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="phone"
      android:textColor="@color/cream"/>
  </com.google.android.material.textfield.TextInputLayout>

  <TextView
    android:id="@+id/label_photo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/alumni_photo"
    android:textColor="@color/text_muted"/>

  <Spinner
    android:id="@+id/spinner_photo"
    android:layout_width="match_parent"
    android:layout_height="48dp"/>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/layout_caption_hnm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:hint="@string/alumni_caption_hnm_person">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/input_caption_hnm"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="top"
      android:inputType="textMultiLine|textCapSentences"
      android:minLines="3"
      android:textColor="@color/cream"/>
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/layout_caption_details"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:hint="@string/alumni_caption_details_person">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/input_caption_details"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="top"
      android:inputType="textMultiLine|textCapSentences"
      android:minLines="3"
      android:textColor="@color/cream"/>
  </com.google.android.material.textfield.TextInputLayout>

  <CheckBox
    android:id="@+id/skip_caption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/skip_caption"
    android:textColor="@color/cream"/>

  <CheckBox
    android:id="@+id/previous_pastor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/alumni_previous_pastor"
    android:textColor="@color/cream"/>

  <CheckBox
    android:id="@+id/contact_saved"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/contact_saved_hint"
    android:textColor="@color/cream"
    android:visibility="gone"/>
</LinearLayout>
