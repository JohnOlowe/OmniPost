<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:scrollbars="none">

      <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/chip_pending"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/filter_pending"
          android:textColor="@color/cream"/>

        <com.google.android.material.button.MaterialButton
          android:id="@+id/chip_posted"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/filter_posted"
          android:textColor="@color/cream"/>

        <com.google.android.material.button.MaterialButton
          android:id="@+id/chip_alumni"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/filter_alumni"
          android:textColor="@color/cream"
          android:visibility="gone"/>
      </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_alumni_captions"
      style="@style/Widget.Material3.Button.OutlinedButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginTop="4dp"
      android:layout_marginEnd="16dp"
      android:text="@string/alumni_edit_captions"
      android:textColor="@color/gold"
      android:visibility="gone"
      app:strokeColor="@color/navy_700"/>

    <EditText
      android:id="@+id/search"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:layout_marginStart="16dp"
      android:layout_marginTop="8dp"
      android:layout_marginEnd="16dp"
      android:background="@drawable/bg_search"
      android:hint="@string/search_tasks"
      android:imeOptions="actionDone"
      android:importantForAutofill="no"
      android:inputType="text|textCapSentences"
      android:maxLines="1"
      android:paddingStart="12dp"
      android:paddingEnd="12dp"
      android:textColor="@color/cream"
      android:textColorHint="@color/text_muted"
      android:textSize="14sp"/>

    <TextView
      android:id="@+id/how_it_works"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginTop="8dp"
      android:layout_marginEnd="16dp"
      android:text="@string/how_it_works"
      android:textColor="@color/text_muted"
      android:textSize="12sp"/>

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        android:paddingBottom="88dp"
        tools:listitem="@layout/item_task"/>

      <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:gravity="center"
        android:text="@string/empty_tasks"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone"/>
    </FrameLayout>
  </LinearLayout>

  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/fab"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_margin="20dp"
    android:contentDescription="@string/add_custom"
    app:backgroundTint="@color/gold"
    app:srcCompat="@drawable/ic_add"
    app:tint="@color/navy_950"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
