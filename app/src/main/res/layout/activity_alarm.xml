<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bg_alarm"
  android:gravity="center"
  android:keepScreenOn="true"
  android:orientation="vertical"
  android:padding="24dp">

  <TextView
    android:id="@+id/phase"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:letterSpacing="0.12"
    android:text="@string/post_now"
    android:textColor="@color/gold"
    android:textSize="14sp"
    android:textStyle="bold"/>

  <TextView
    android:id="@+id/title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:gravity="center"
    android:text="@string/app_name"
    android:textColor="@color/cream"
    android:textSize="32sp"
    android:textStyle="bold"/>

  <TextView
    android:id="@+id/when"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:textColor="@color/text_muted"
    android:textSize="16sp"/>

  <TextView
    android:id="@+id/subtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:gravity="center"
    android:text="@string/alarm_subtitle"
    android:textColor="@color/text_muted"/>

  <TextView
    android:id="@+id/pulse"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:gravity="center"
    android:text="@string/pulse_vibrating"
    android:textColor="@color/gold"
    android:textStyle="bold"/>

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btn_draft"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="36dp"
    android:backgroundTint="@color/gold"
    android:text="@string/open_draft"
    android:textColor="@color/navy_950"/>

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btn_posted"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:backgroundTint="@color/whatsapp"
    android:text="@string/i_posted_it"
    android:textColor="@color/cream"/>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_nag_30"
      style="@style/Widget.Material3.Button.OutlinedButton"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:text="@string/nag_later"
      android:textColor="@color/gold"
      app:strokeColor="@color/gold_dim"/>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_nag_hour"
      style="@style/Widget.Material3.Button.OutlinedButton"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_weight="1"
      android:text="@string/nag_later"
      android:textColor="@color/gold"
      app:strokeColor="@color/gold_dim"/>
  </LinearLayout>

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btn_snooze"
    style="@style/Widget.Material3.Button.OutlinedButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/nag_later"
    android:textColor="@color/gold"
    app:strokeColor="@color/gold_dim"/>

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btn_later"
    style="@style/Widget.Material3.Button.TextButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/keep_nagging"
    android:textColor="@color/text_muted"
    app:rippleColor="@color/gold_soft"/>
</LinearLayout>
