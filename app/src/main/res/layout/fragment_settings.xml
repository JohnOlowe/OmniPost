<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/settings_title"
      android:textColor="@color/cream"
      android:textSize="20sp"
      android:textStyle="bold"/>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="16dp"
      android:text="@string/settings_body"
      android:textColor="@color/text_muted"
      android:textSize="14sp"/>

    <include
      android:id="@+id/row_alert"
      layout="@layout/item_setting_row"/>

    <include
      android:id="@+id/row_nag"
      layout="@layout/item_setting_row"/>

    <include
      android:id="@+id/row_warning"
      layout="@layout/item_setting_row"/>

    <include
      android:id="@+id/row_seed"
      layout="@layout/item_switch_row"/>

    <include
      android:id="@+id/row_desk"
      layout="@layout/item_switch_row"/>

    <include
      android:id="@+id/row_fullscreen_pref"
      layout="@layout/item_switch_row"/>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/series_section"
      android:textColor="@color/cream"
      android:textSize="20sp"
      android:textStyle="bold"/>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="8dp"
      android:text="@string/series_section_body"
      android:textColor="@color/text_muted"
      android:textSize="14sp"/>

    <LinearLayout
      android:id="@+id/series_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"/>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_add_countdown"
      style="@style/Widget.Material3.Button.OutlinedButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/add_countdown"
      android:textColor="@color/gold"
      app:strokeColor="@color/gold"/>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_add_notice"
      style="@style/Widget.Material3.Button.OutlinedButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/add_monthly"
      android:textColor="@color/gold"
      app:strokeColor="@color/gold"/>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/survival_title"
      android:textColor="@color/cream"
      android:textSize="20sp"
      android:textStyle="bold"/>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="16dp"
      android:text="@string/survival_body"
      android:textColor="@color/text_muted"
      android:textSize="14sp"/>

    <include
      android:id="@+id/row_notifications"
      layout="@layout/item_survive_row"/>

    <include
      android:id="@+id/row_exact"
      layout="@layout/item_survive_row"/>

    <include
      android:id="@+id/row_battery"
      layout="@layout/item_survive_row"/>

    <include
      android:id="@+id/row_fullscreen"
      layout="@layout/item_survive_row"/>

    <include
      android:id="@+id/row_overlay"
      layout="@layout/item_survive_row"/>

    <include
      android:id="@+id/row_accessibility"
      layout="@layout/item_survive_row"/>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      app:cardBackgroundColor="@color/navy_800"
      app:cardCornerRadius="16dp"
      app:cardElevation="0dp"
      app:strokeColor="@color/gold_dim"
      app:strokeWidth="1dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/oem_title"
          android:textColor="@color/gold"
          android:textStyle="bold"/>

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="@string/oem_body"
          android:textColor="@color/text_muted"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_test"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:backgroundTint="@color/gold"
      android:text="@string/test_nag"
      android:textColor="@color/navy_950"/>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_rearm"
      style="@style/Widget.Material3.Button.OutlinedButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/rearm"
      android:textColor="@color/gold"
      app:strokeColor="@color/gold"/>
  </LinearLayout>
</ScrollView>
