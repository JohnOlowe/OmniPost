<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="Base.AppTheme" parent="Theme.Material3.Dark.NoActionBar">
    <item name="colorPrimary">@color/gold</item>
    <item name="colorOnPrimary">@color/navy_950</item>
    <item name="colorPrimaryContainer">@color/navy_800</item>
    <item name="colorOnPrimaryContainer">@color/gold</item>
    <item name="colorSecondary">@color/gold_dim</item>
    <item name="colorOnSecondary">@color/navy_950</item>
    <item name="colorSurface">@color/navy_800</item>
    <item name="colorOnSurface">@color/text_primary</item>
    <item name="colorOnSurfaceVariant">@color/text_muted</item>
    <item name="android:statusBarColor">@color/navy_950</item>
    <item name="android:navigationBarColor">@color/navy_950</item>
    <item name="android:windowBackground">@color/navy_950</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    <item name="materialAlertDialogTheme">@style/OmniPost.Dialog</item>
  </style>

  <style name="AppTheme" parent="Base.AppTheme"/>

  <style name="AppTheme.Alarm" parent="AppTheme">
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowShowWallpaper">false</item>
    <item name="android:windowBackground">@color/alarm_start</item>
  </style>

  <style name="OmniPost.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <item name="android:background">@color/navy_800</item>
    <item name="colorSurface">@color/navy_800</item>
    <item name="colorOnSurface">@color/cream</item>
  </style>
</resources>
